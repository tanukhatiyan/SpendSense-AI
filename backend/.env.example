# SpendSense AI — Backend Environment Configuration Example

# Project Settings
PROJECT_NAME="SpendSense-AI"
VERSION="1.0.0"

# Database Configuration
# For local zero-config testing:
DATABASE_URL="sqlite:///./spendsense.db"
# For PostgreSQL in local development or Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendsensedb"

# Security & Authentication
# Generate a secure secret in production using: openssl rand -hex 32
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Assistant Provider Configuration
# Supported providers: 'mock', 'gemini', 'openai', 'groq'
AI_PROVIDER="mock"

# Provide the API key for your chosen provider:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
